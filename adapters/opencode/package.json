{
  "name": "@atape/adapter-opencode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:build",
    "vitest": "catalog:build",
    "effect": "catalog:",
    "@atape/domain": "workspace:*",
    "esbuild": "catalog:build"
  },
  "description": "Private ATape Adapter candidate for local OpenCode SQLite history",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "atapeAdapter": {
    "protocolVersion": "atape.adapter.v1alpha1",
    "sourceCapture": "atape.source-capture.v1",
    "adapterId": "opencode",
    "displayName": "OpenCode",
    "entry": "./dist/index.js",
    "harnesses": [
      "OpenCode"
    ]
  }
}
