{
  "name": "@atape/adapter-codex",
  "version": "0.1.0",
  "description": "ATape Adapter for local Codex rollout archives",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/codexArchive.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@atape/domain": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  },
  "atapeAdapter": {
    "protocolVersion": "atape.adapter.v1alpha1",
    "adapterId": "codex",
    "displayName": "Codex",
    "entry": "./src/index.ts",
    "harnesses": [
      "codex"
    ]
  }
}
