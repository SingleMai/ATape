{
  "name": "@atape/adapter-cursor",
  "version": "0.5.5",
  "type": "module",
  "description": "ATape Adapter for controlled Cursor sessions and native transcripts",
  "exports": { ".": "./dist/index.js" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:release": "node ../../scripts/pack-adapter.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:build",
    "vitest": "catalog:build",
    "effect": "catalog:",
    "@atape/domain": "workspace:*",
    "@atape/adapter-catalog": "workspace:*",
    "esbuild": "catalog:build"
  },
  "engines": { "node": ">=24" },
  "license": "MIT",
  "files": ["dist/index.js", "README.md", "LICENSE"],
  "atapeAdapter": {
    "protocolVersion": "atape.adapter.v1alpha1",
    "adapterId": "cursor",
    "displayName": "Cursor CLI",
    "entry": "./dist/index.js",
    "harnesses": ["cursor"],
    "gitAttribution": "atape.git-attribution.v1",
    "sourceCapture": "atape.source-capture.v2",
    "newSession": "atape.new-session.v1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingleMai/ATape.git",
    "directory": "adapters/cursor"
  },
  "homepage": "https://github.com/SingleMai/ATape#readme",
  "bugs": { "url": "https://github.com/SingleMai/ATape/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
