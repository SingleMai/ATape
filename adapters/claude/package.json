{
  "name": "@atape/adapter-claude",
  "version": "0.5.0",
  "description": "ATape Adapter for project-scoped Claude Code local sessions",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingleMai/ATape.git",
    "directory": "adapters/claude"
  },
  "homepage": "https://github.com/SingleMai/ATape#readme",
  "bugs": {
    "url": "https://github.com/SingleMai/ATape/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:release": "node ../../scripts/pack-adapter.mjs",
    "verify:package": "node ../../scripts/verify-adapter-package.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@atape/domain": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "catalog:build",
    "effect": "catalog:",
    "typescript": "catalog:build",
    "vitest": "catalog:build",
    "@atape/adapter-catalog": "workspace:*"
  },
  "atapeAdapter": {
    "protocolVersion": "atape.adapter.v1alpha1",
    "gitAttribution": "atape.git-attribution.v1",
    "rawCapturePolicy": "atape.raw-capture.v1",
    "adapterId": "claude",
    "displayName": "Claude Code",
    "entry": "./dist/index.js",
    "harnesses": [
      "claude-code"
    ]
  }
}
