# Loopback is the safe first-run topology. For Internet-facing use, terminate
# TLS before this Compose stack and set the canonical HTTPS URL here.
ATAPE_PUBLIC_URL=http://127.0.0.1:8080
ATAPE_API_PUBLIC_URL=
ATAPE_COOKIE_DOMAIN=
ATAPE_DEVELOPMENT_ALLOW_HTTP=true

ATAPE_BIND_ADDRESS=127.0.0.1
ATAPE_PORT=8080

# Phase-one deployments require one GitHub OAuth App. Its callback is
# ${ATAPE_API_PUBLIC_URL or ATAPE_PUBLIC_URL}/api/v1/auth/github/callback.
ATAPE_GITHUB_CLIENT_ID=

# Keep normal for a fresh installation. A mapped v0.1.1 upgrade temporarily
# uses bootstrap while the reviewed auth-cutover mapping is applied.
ATAPE_AUTH_CUTOVER_MODE=normal

# These are host paths consumed as Compose secrets. Generate the first four
# with scripts/generate-self-hosted-secrets.sh, then write the GitHub client
# secret to the final file with mode 0600.
ATAPE_POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password
ATAPE_DATABASE_URL_SECRET_FILE=./secrets/database_url
ATAPE_AUTH_PEPPER_KEY_RING_SECRET_FILE=./secrets/auth_pepper_key_ring.json
ATAPE_AUTH_PRIVATE_STATE_KEY_RING_SECRET_FILE=./secrets/auth_private_state_key_ring.json
ATAPE_GITHUB_CLIENT_SECRET_FILE=./secrets/github_client_secret

# Split-origin only: publish the API on loopback for a second TLS virtual host
# by adding -f compose.split-origin.yaml. Never bind this port publicly.
ATAPE_API_BIND_ADDRESS=127.0.0.1
ATAPE_API_PORT=8081
