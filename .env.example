# The default binds ATape only to this machine. Use 0.0.0.0 only behind a
# trusted network or an authenticating TLS reverse proxy.
ATAPE_BIND_ADDRESS=127.0.0.1
ATAPE_PORT=8080

# Use a URL-safe password because Compose also interpolates it into the pgx
# connection URL. Change this before exposing a persistent deployment.
ATAPE_POSTGRES_PASSWORD=atape
