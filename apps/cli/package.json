{
  "name": "@atape/cli",
  "version": "0.5.0",
  "description": "CLI and background Collector for ATape shared agent conversation history",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SingleMai/ATape.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/SingleMai/ATape#readme",
  "bugs": {
    "url": "https://github.com/SingleMai/ATape/issues"
  },
  "keywords": [
    "agent",
    "conversation",
    "harness",
    "team",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atape": "dist/atape.js"
  },
  "files": [
    "dist/atape.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/main.ts",
    "i18n:extract": "i18next",
    "pack:release": "node scripts/pack.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "vitest run --exclude src/collectorServer.e2e.test.ts",
    "test:e2e": "vitest run src/collectorServer.e2e.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:capture-disk": "node scripts/verify-capture-disk.mjs"
  },
  "devDependencies": {
    "@atape/application": "workspace:*",
    "@atape/domain": "workspace:*",
    "@atape/i18n": "workspace:*",
    "@inkjs/ui": "2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "catalog:build",
    "effect": "catalog:",
    "esbuild": "catalog:build",
    "i18next-parser": "9.4.0",
    "ink": "7.1.1",
    "react": "catalog:",
    "string-width": "8.2.2",
    "typescript": "catalog:build",
    "vitest": "catalog:build"
  }
}
